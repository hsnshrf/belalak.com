# ──────────────────────────────────────────────────────────────────────────────
# VoiceVault environment template. Copy to .env and fill in real values.
# Every variable consumed by apps/api and apps/web is listed here.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# ── Database (PostgreSQL 14+, requires pg_trgm extension) ────────────────────
DATABASE_URL=postgres://voicevault:voicevault@localhost:5432/voicevault

# ── Redis (BullMQ job queue) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (any S3-compatible: AWS S3, MinIO, Cloudflare R2) ─────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=voicevault-audio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Force path-style addressing (required for MinIO, harmless for AWS)
S3_FORCE_PATH_STYLE=true
# Seconds a signed playback/download URL stays valid
S3_SIGNED_URL_TTL_SECONDS=900

# ── Auth ─────────────────────────────────────────────────────────────────────
# 256-bit secret for signing JWTs, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# OAuth — leave a provider blank to disable it in the UI
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
# Contents (or file path) of the Apple .p8 private key
OAUTH_APPLE_PRIVATE_KEY=

# ── Transcription providers ──────────────────────────────────────────────────
# Which adapter to use by default: whisper_api | deepgram | local_whisper
TRANSCRIPTION_PROVIDER=whisper_api

# (a) OpenAI Whisper API
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# (b) Deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# (c) Local whisper.cpp (self-hosted mode) — path to the whisper.cpp binary
#     and model file; used when TRANSCRIPTION_PROVIDER=local_whisper
WHISPER_CPP_BINARY=/usr/local/bin/whisper-cli
WHISPER_CPP_MODEL=/models/ggml-large-v3.bin

# ── AI post-processing (summaries, action items, tag suggestions) ────────────
# Anthropic API key; used by the summaries/suggestions service
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Web app (Next.js — NEXT_PUBLIC_* are exposed to the browser) ─────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
